<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seatflow.user.UserMapper">
    <resultMap id="UserRecordResultMap" type="com.seatflow.user.UserRecord">
        <constructor>
            <idArg column="id" javaType="java.util.UUID" />
            <arg column="email" javaType="java.lang.String" />
            <arg column="password_hash" javaType="java.lang.String" />
            <arg column="role" javaType="com.seatflow.user.UserRole" />
            <arg column="status" javaType="com.seatflow.user.UserStatus" />
            <arg column="created_at" javaType="java.time.Instant" />
            <arg column="updated_at" javaType="java.time.Instant" />
        </constructor>
    </resultMap>

    <insert id="insert" parameterType="com.seatflow.user.UserRecord">
        INSERT INTO users (
            id,
            email,
            password_hash
        )
        VALUES (
            #{id},
            #{email},
            #{passwordHash}
        )
    </insert>

    <select id="findById" resultMap="UserRecordResultMap">
        SELECT
            id,
            email,
            password_hash,
            role,
            status,
            created_at,
            updated_at
        FROM users
        WHERE id = #{id}
    </select>

    <select id="findByNormalizedEmail" resultMap="UserRecordResultMap">
        SELECT
            id,
            email,
            password_hash,
            role,
            status,
            created_at,
            updated_at
        FROM users
        WHERE lower(email) = #{normalizedEmail}
    </select>

    <update id="updateStatus">
        UPDATE users
        SET
            status = #{status},
            updated_at = NOW()
        WHERE id = #{id}
    </update>
</mapper>
