<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seatflow.reservation.ReservationItemMapper">
    <resultMap id="ReservationItemRecordResultMap" type="com.seatflow.reservation.ReservationItemRecord">
        <constructor>
            <idArg column="id" javaType="java.util.UUID" />
            <arg column="reservation_id" javaType="java.util.UUID" />
            <arg column="event_seat_id" javaType="java.util.UUID" />
            <arg column="price" javaType="java.math.BigDecimal" />
            <arg column="created_at" javaType="java.time.Instant" />
        </constructor>
    </resultMap>

    <insert id="batchInsert">
        INSERT INTO reservation_items (
            id,
            reservation_id,
            event_seat_id,
            price,
            created_at
        )
        VALUES
        <foreach collection="items" item="item" separator=",">
            (
                #{item.id},
                #{item.reservationId},
                #{item.eventSeatId},
                #{item.price},
                #{item.createdAt}
            )
        </foreach>
    </insert>

    <select id="findByReservationId" resultMap="ReservationItemRecordResultMap">
        SELECT
            id,
            reservation_id,
            event_seat_id,
            price,
            created_at
        FROM reservation_items
        WHERE reservation_id = #{reservationId}
        ORDER BY created_at ASC, id ASC
    </select>
</mapper>
