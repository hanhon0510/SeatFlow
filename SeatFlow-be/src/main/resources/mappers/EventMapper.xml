<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seatflow.event.EventMapper">
    <resultMap id="EventRecordResultMap" type="com.seatflow.event.EventRecord">
        <constructor>
            <idArg column="id" javaType="java.util.UUID" />
            <arg column="venue_id" javaType="java.util.UUID" />
            <arg column="name" javaType="java.lang.String" />
            <arg column="description" javaType="java.lang.String" />
            <arg column="start_time" javaType="java.time.Instant" />
            <arg column="sales_start_time" javaType="java.time.Instant" />
            <arg column="sales_end_time" javaType="java.time.Instant" />
            <arg column="status" javaType="com.seatflow.event.EventStatus" />
            <arg column="created_at" javaType="java.time.Instant" />
            <arg column="updated_at" javaType="java.time.Instant" />
        </constructor>
    </resultMap>

    <sql id="EventColumns">
        id,
        venue_id,
        name,
        description,
        start_time,
        sales_start_time,
        sales_end_time,
        status,
        created_at,
        updated_at
    </sql>

    <insert id="insert" parameterType="com.seatflow.event.EventRecord">
        INSERT INTO events (
            id,
            venue_id,
            name,
            description,
            start_time,
            sales_start_time,
            sales_end_time
        )
        VALUES (
            #{id},
            #{venueId},
            #{name},
            #{description},
            #{startTime},
            #{salesStartTime},
            #{salesEndTime}
        )
    </insert>

    <update id="update" parameterType="com.seatflow.event.EventRecord">
        UPDATE events
        SET
            venue_id = #{venueId},
            name = #{name},
            description = #{description},
            start_time = #{startTime},
            sales_start_time = #{salesStartTime},
            sales_end_time = #{salesEndTime},
            updated_at = NOW()
        WHERE id = #{id}
          AND (status &lt;&gt; 'PUBLISHED' OR venue_id = #{venueId})
    </update>

    <select id="findById" resultMap="EventRecordResultMap">
        SELECT
            <include refid="EventColumns" />
        FROM events
        WHERE id = #{id}
    </select>

    <select id="findByIdForUpdate" resultMap="EventRecordResultMap">
        SELECT
            <include refid="EventColumns" />
        FROM events
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <select id="findPage" resultMap="EventRecordResultMap">
        SELECT
            <include refid="EventColumns" />
        FROM events
        ORDER BY start_time ASC, name ASC, id ASC
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM events
    </select>
</mapper>
