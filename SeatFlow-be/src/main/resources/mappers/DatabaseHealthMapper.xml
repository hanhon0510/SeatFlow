<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seatflow.health.DatabaseHealthMapper">
    <select id="findSystemHealthStatus" resultType="string">
        SELECT status
        FROM system_health
        WHERE id = 1
    </select>
</mapper>

