<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seatflow.promo.PromoCodeMapper">
    <resultMap id="PromoCodeRecordResultMap" type="com.seatflow.promo.PromoCodeRecord">
        <constructor>
            <idArg column="id" javaType="java.util.UUID" />
            <arg column="code" javaType="java.lang.String" />
            <arg column="discount_type" javaType="com.seatflow.promo.PromoDiscountType" />
            <arg column="discount_value" javaType="java.math.BigDecimal" />
            <arg column="event_id" javaType="java.util.UUID" />
            <arg column="expires_at" javaType="java.time.Instant" />
            <arg column="max_uses" javaType="java.lang.Integer" />
            <arg column="active" javaType="_boolean" />
            <arg column="used_count" javaType="_long" />
            <arg column="created_at" javaType="java.time.Instant" />
            <arg column="updated_at" javaType="java.time.Instant" />
        </constructor>
    </resultMap>

    <!--
        A use is a live (PENDING or PAID) order carrying the code. Orders that are cancelled or failed
        stop counting by themselves, so an abandoned checkout gives its use back without a release step.
    -->
    <sql id="PromoCodeColumns">
        promo.id,
        promo.code,
        promo.discount_type,
        promo.discount_value,
        promo.event_id,
        promo.expires_at,
        promo.max_uses,
        promo.active,
        (
            SELECT COUNT(*)
            FROM orders purchase_order
            WHERE purchase_order.promo_code_id = promo.id
              AND purchase_order.status IN ('PENDING', 'PAID')
        ) AS used_count,
        promo.created_at,
        promo.updated_at
    </sql>

    <insert id="insert">
        INSERT INTO promo_codes (
            id,
            code,
            discount_type,
            discount_value,
            event_id,
            expires_at,
            max_uses,
            active,
            created_at,
            updated_at
        )
        VALUES (
            #{id},
            #{code},
            #{discountType},
            #{discountValue},
            #{eventId},
            #{expiresAt},
            #{maxUses},
            TRUE,
            #{now},
            #{now}
        )
    </insert>

    <select id="findById" resultMap="PromoCodeRecordResultMap">
        SELECT
            <include refid="PromoCodeColumns" />
        FROM promo_codes promo
        WHERE promo.id = #{id}
    </select>

    <select id="findByCode" resultMap="PromoCodeRecordResultMap">
        SELECT
            <include refid="PromoCodeColumns" />
        FROM promo_codes promo
        WHERE promo.code = #{code}
    </select>

    <select id="findByCodeForUpdate" resultMap="PromoCodeRecordResultMap">
        SELECT
            <include refid="PromoCodeColumns" />
        FROM promo_codes promo
        WHERE promo.code = #{code}
        FOR UPDATE OF promo
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM promo_codes
    </select>

    <select id="findPage" resultMap="PromoCodeRecordResultMap">
        SELECT
            <include refid="PromoCodeColumns" />
        FROM promo_codes promo
        ORDER BY promo.created_at DESC, promo.id DESC
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <update id="deactivate">
        UPDATE promo_codes
        SET
            active = FALSE,
            updated_at = #{now}
        WHERE id = #{id}
          AND active = TRUE
    </update>
</mapper>
